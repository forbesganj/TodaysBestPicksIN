# ============================================================
# COPY THIS FILE TO .env FOR LOCAL TESTING ONLY.
# In production (GitHub Actions) these are set as GitHub Secrets,
# NEVER committed to the repo. See README "GitHub Secrets Setup".
# ============================================================

# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
TELEGRAM_CHANNEL_ID=@DailyVaultIN

# --- Deal filtering ---
MIN_DISCOUNT_PERCENT=40
MAX_POSTS_PER_RUN=10

# --- Amazon PA-API 5.0 (optional - only if you have Associates approval) ---
# Enable/disable this source without deleting credentials
AMAZON_ENABLED=false
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=yourtag-21
AMAZON_COUNTRY=IN
# Comma-separated search keywords PA-API will query
AMAZON_SEARCH_KEYWORDS=electronics,headphones,kitchen appliances,shoes

# --- Flipkart Affiliate Feed (optional - only if approved) ---
FLIPKART_ENABLED=false
# Feed URL(s) issued to you in the Flipkart Affiliate dashboard, comma-separated
FLIPKART_FEED_URLS=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# --- Generic affiliate feed adapter (Myntra / Ajio / Meesho via
#     EarnKaro / INRDeals / Cuelinks / Admitad etc., once approved) ---
GENERIC_FEEDS_ENABLED=false
# JSON list of {"name": "...", "url": "...", "format": "json"|"csv"}
# stored as a single-line JSON string. Example:
# [{"name":"Myntra-EarnKaro","url":"https://.../feed.json","format":"json"}]
GENERIC_FEEDS_CONFIG=[]
